# Names only. Copy to .env.local and fill in. Never commit real values.
# Local development: run `npm run db:start`, then take the first three from `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY). On Railway: the staging Supabase project's URL, anon key and service-role key (T04).

# Browser-visible (the only ones that may be):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only:
SUPABASE_SERVICE_ROLE_KEY=

# Optional password curtain for staging and demos (8+ characters). Empty = no curtain. /demo and /api are never behind it.
SITE_PASSWORD=

# Development only: the laptop's Wi-Fi address, to open `npm run dev` from a phone (comma-separated). Leave empty otherwise.
DEV_ORIGINS=

# Later tasks add: VISION_MODE, AI_MODE (fake|live), ANTHROPIC_API_KEY, ANTHROPIC_MODEL (Q8), SCANS_PER_DAY (Q8).
